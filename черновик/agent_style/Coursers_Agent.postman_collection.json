{
  "info": {
    "name": "Coursers — учебный текстовый агент Ollama",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Запускать после черновик/run_agent_style.py. Коллекция создаёт отдельный аккаунт с уникальным email, проверяет команды, меняет email и удаляет созданный аккаунт. Использует базу запущенного приложения. Не заменяйте access_token токеном основного аккаунта перед DELETE."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8001",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "agent_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "updated_email",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — REGISTER: создать отдельный учебный аккаунт",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = Date.now();",
              "pm.collectionVariables.set(\"agent_email\", `agent_demo_${stamp}@example.com`);",
              "pm.collectionVariables.set(\"updated_email\", `agent_updated_${stamp}@example.com`);",
              "pm.collectionVariables.set(\"access_token\", \"\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Зарегистрируй новый аккаунт: full_name Agent Demo, email {{agent_email}}, password qwerty123!, role student, is_active false.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/agent/register/"
      }
    },
    {
      "name": "02 — LOGIN: получить access_token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"access_token получен\", () => pm.expect(data.access_token).to.be.a(\"string\"));",
              "if (data.access_token) pm.collectionVariables.set(\"access_token\", data.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{agent_email}}\",\n  \"password\": \"qwerty123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/auth/login/"
      }
    },
    {
      "name": "03 — ФИО, почта, роль",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"answer — строка\", () => pm.expect(pm.response.json().answer).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Покажи мой профиль: фио, почту и роль.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/agent/chat/"
      }
    },
    {
      "name": "04 — ID",
