        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Измени мой email на {{updated_email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/agent/chat/"
      }
    },
    {
      "name": "11 — Проверить новый email через агента",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"email изменён\", () => pm.expect(pm.response.json().answer).to.include(pm.collectionVariables.get(\"updated_email\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
